---
// Opening scene: Jesslyn rowing on a painted sea, with orange fish.
// Stand-in art drawn in code; swap the <svg> inside .vessel for painted PNG layers later.
const bubbles = [
  "Hey there! I'm Jesslyn",
  'I love building joyful things and solving problems',
  'A generalist with many interests',
  '<strong>Focus: Software Development</strong>',
];
---
<section class="hero" id="hero" aria-label="Jesslyn rowing a boat on a painted sea">
  <svg class="sea" id="sea" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g filter="url(#wc)">
      <path d="M-40 330 C 200 300, 420 350, 640 320 S 1040 300, 1260 330 L1260 760 L-40 760 Z" fill="#9DB3B5" opacity=".75" />
      <path d="M-40 420 C 260 395, 520 450, 780 410 S 1100 420, 1260 400 L1260 760 L-40 760 Z" fill="#8AA3A6" opacity=".55" />
      <path d="M-40 560 C 300 540, 640 590, 900 555 S 1160 560, 1260 545 L1260 760 L-40 760 Z" fill="#7E989B" opacity=".45" />
    </g>
    <g fill="none" stroke="#F1EFE9" stroke-width="2" stroke-linecap="round" opacity=".8" filter="url(#wobble)">
      <path d="M140 390 q 20 -6 40 0" /><path d="M880 370 q 26 -7 52 0" /><path d="M560 470 q 18 -5 36 0" />
      <path d="M1020 510 q 22 -6 44 0" /><path d="M300 600 q 26 -6 52 0" />
    </g>
    <g data-fish></g>
    <g data-ripples fill="none" stroke="#F1EFE9" stroke-width="2"></g>
  </svg>

  <div class="hero-copy">
    <h1>Jesslyn Devina</h1>
    <span class="hand">come along my journey</span>
  </div>

  <div class="vessel" data-vessel>
    <div class="bubbles" aria-live="polite">
      {bubbles.map((text) => <p class="bubble" set:html={text} />)}
      <p class="bubble typing" hidden aria-hidden="true"><span></span><span></span><span></span></p>
    </div>
    <svg viewBox="0 0 260 170" aria-hidden="true">
      <g filter="url(#wc)">
        <ellipse cx="128" cy="72" rx="20" ry="24" fill="#E8873A" />
        <path d="M108 70 q 20 -20 40 0 l 0 30 l -40 0 z" fill="#E8873A" />
      </g>
      <circle cx="128" cy="40" r="15" fill="#E9C9A9" stroke="#2B2A26" stroke-width="1.5" />
      <path d="M113 38 q 2 -18 18 -16 q 14 2 12 16 q -6 -8 -16 -6 q -8 2 -14 6 z" fill="#2B2A26" />
      <circle cx="140" cy="24" r="7" fill="#2B2A26" />
      <g filter="url(#wc)"><path d="M30 98 Q 130 92 230 98 Q 214 140 130 142 Q 50 140 30 98 Z" fill="#8C6446" /></g>
      <path d="M30 98 Q 130 92 230 98 Q 214 140 130 142 Q 50 140 30 98 Z" fill="none" stroke="#2B2A26" stroke-width="1.6" />
      <path d="M44 112 Q 130 118 218 112" fill="none" stroke="#2B2A26" stroke-width="1" opacity=".5" />
    </svg>
  </div>
  <div class="rock" aria-label="Signpost on a rock: Vancouver, Canada" role="img">
    <svg viewBox="0 0 200 170" aria-hidden="true">
      <path d="M96 118 L 98 40" stroke="#6B4A33" stroke-width="5" stroke-linecap="round" />
      <g transform="rotate(-4 98 46)">
        <path d="M18 24 L 178 20 L 180 66 L 20 70 Z" fill="#C9A27E" stroke="#2B2A26" stroke-width="1.6" stroke-linejoin="round" filter="url(#wobble)" />
        <text x="99" y="51" text-anchor="middle" class="sign" textLength="136" lengthAdjust="spacingAndGlyphs">Vancouver, Canada</text>
      </g>
      <g filter="url(#wc)">
        <path d="M40 150 Q 46 112 82 104 Q 112 96 138 110 Q 166 124 168 150 Z" fill="#8A8D8F" />
        <path d="M70 150 Q 78 122 104 116 Q 128 114 140 132 Q 146 142 146 150 Z" fill="#6F7375" opacity=".7" />
      </g>
      <path d="M40 150 Q 46 112 82 104 Q 112 96 138 110 Q 166 124 168 150" fill="none" stroke="#2B2A26" stroke-width="1.5" filter="url(#wobble)" />
      <path d="M24 152 q 20 -6 40 0 M 140 152 q 22 -6 44 0" fill="none" stroke="#F1EFE9" stroke-width="2" stroke-linecap="round" />
    </svg>
  </div>
  <p class="cue" aria-hidden="true">scroll to row along <span>↓</span></p>
</section>

<style>
  .hero { position: relative; height: clamp(520px, 92vh, 860px); overflow: hidden; cursor: crosshair; }
  .sea { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-copy { position: absolute; left: var(--gutter); top: clamp(28px, 7vh, 64px); display: grid; gap: 8px; z-index: 3; pointer-events: none; }
  h1 { font-size: clamp(34px, 5.5vw, 64px); line-height: 1; }
  .hero-copy .hand { font-size: 22px; }
  .vessel { position: absolute; left: 10%; top: 60%; width: clamp(170px, 22vw, 260px); z-index: 2; will-change: transform; }
  .vessel svg { width: 100%; height: auto; display: block; overflow: visible; }
  .bubbles { position: absolute; left: 66%; bottom: 62%; display: flex; flex-direction: column; gap: 6px; align-items: flex-start; width: max-content; max-width: min(280px, 62vw); transition: opacity 0.35s var(--ease), transform 0.35s var(--ease); }
  .bubbles:global(.gone) { opacity: 0; transform: translateY(-8px); pointer-events: none; }
  .bubble {
    background: var(--bubble); border: 1.5px solid var(--ink); padding: 7px 14px;
    border-radius: 16px 16px 16px 4px; font-size: 14px; line-height: 1.35;
    transform-origin: 0 100%; opacity: 0; transform: scale(0.6) translateY(6px);
  }
  .bubble:global(.on) { animation: pop 0.45s var(--ease) forwards; }
  @keyframes pop { to { opacity: 1; transform: none; } }
  .typing { display: flex; gap: 4px; padding: 11px 14px; }
  .typing[hidden] { display: none; }
  .typing span { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: dot 1s ease-in-out infinite; }
  .typing span:nth-child(2) { animation-delay: 0.15s; }
  .typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes dot { 0%, 60%, 100% { transform: translateY(0); opacity: 0.5; } 30% { transform: translateY(-3px); opacity: 1; } }
  .rock { position: absolute; right: 7%; top: 40%; width: clamp(140px, 16vw, 210px); z-index: 1; pointer-events: none; }
  .rock svg { width: 100%; height: auto; display: block; overflow: visible; }
  .sign { font: 18px var(--hand); fill: var(--ink); }
  .cue { position: absolute; right: var(--gutter); bottom: 24px; font: 20px var(--hand); color: var(--walnut); z-index: 3; pointer-events: none; }
  .cue span { display: inline-block; animation: nudge 2.4s ease-in-out infinite; }
  @keyframes nudge { 50% { transform: translateY(5px); } }
  @media (max-width: 560px) {
    .vessel { left: 4%; top: 64%; }
    .bubbles { left: 46%; bottom: 102%; }
    .rock { right: 3%; top: 70%; width: 120px; }
  }
  @media (prefers-reduced-motion: reduce) { .bubble { opacity: 1; transform: none; } }
</style>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hero = document.getElementById('hero')!;
  const sea = document.getElementById('sea') as unknown as SVGSVGElement;
  const vessel = hero.querySelector<HTMLElement>('[data-vessel]')!;
  const bubbleStack = hero.querySelector<HTMLElement>('.bubbles')!;
  const fishLayer = hero.querySelector('[data-fish]')!;
  const rippleLayer = hero.querySelector('[data-ripples]')!;

  const svg = (tag: string, attrs: Record<string, string | number>, parent: Element) => {
    const n = document.createElementNS(NS, tag);
    for (const k in attrs) n.setAttribute(k, String(attrs[k]));
    parent.appendChild(n);
    return n;
  };

  // Chat bubbles pop up one after another from the rower.
  // Like a chat: typing dots, then the message, one at a time.
  const messages = [...hero.querySelectorAll<HTMLElement>('.bubble:not(.typing)')];
  const typing = hero.querySelector<HTMLElement>('.bubble.typing')!;
  if (reduce) messages.forEach((m) => m.classList.add('on'));
  else {
    messages.forEach((m) => (m.hidden = true));
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      await wait(500);
      for (const m of messages) {
        m.before(typing);
        typing.hidden = false;
        typing.classList.add('on');
        await wait(650);
        typing.hidden = true;
        m.hidden = false;
        m.classList.add('on');
        await wait(350);
      }
    })();
  }

  // Three fish that wander: each picks a spot in the water, turns towards it gradually,
  // cruises or idles, and wags its tail faster the faster it swims.
  const rand = (lo: number, hi: number) => lo + Math.random() * (hi - lo);
  // The sea is drawn with "slice", so only part of the 1200×700 drawing is visible at narrow widths.
  const water = { x0: 40, x1: 1160, y0: 480, y1: 670 }; // below the boat
  function fitWater() {
    const { width, height } = sea.getBoundingClientRect();
    const scale = Math.max(width / 1200, height / 700);
    const visible = width / scale;
    water.x0 = (1200 - visible) / 2 + 40;
    water.x1 = (1200 + visible) / 2 - 40;
  }
  fitWater();
  addEventListener('resize', fitWater);

  type Fish = {
    g: SVGGElement; tail: SVGGElement;
    x: number; y: number; heading: number; speed: number; cruise: number;
    tx: number; ty: number; until: number; wag: number; flee: number; turn: number;
  };
  const pickTarget = (f: Fish, now: number) => {
    f.tx = rand(water.x0, water.x1);
    f.ty = rand(water.y0, water.y1);
    const idle = Math.random() < 0.25;
    f.cruise = idle ? rand(4, 10) : rand(28, 60);
    f.until = now + (idle ? rand(1.2, 2.8) : rand(4, 9));
  };
  const fish: Fish[] = [[380, 520], [760, 470], [980, 600]].map(([x, y]) => {
    const g = svg('g', {}, fishLayer) as SVGGElement;
    const tail = svg('g', { filter: 'url(#wc)' }, g) as SVGGElement;
    svg('path', { d: 'M-12 0 L-26 -8 L-23 0 L-26 8 Z', fill: '#E8873A' }, tail);
    svg('ellipse', { cx: 0, cy: 0, rx: 16, ry: 8, fill: '#E8873A', filter: 'url(#wc)' }, g);
    svg('circle', { cx: 9, cy: -2, r: 1.6, fill: '#2B2A26' }, g);
    const f: Fish = { g, tail, x, y, heading: rand(-Math.PI, Math.PI), speed: 20, cruise: 30, tx: x, ty: y, until: 0, wag: rand(0, 6), flee: 0, turn: 1 };
    pickTarget(f, 0);
    return f;
  });

  const wrap = (a: number) => Math.atan2(Math.sin(a), Math.cos(a));
  function swim(f: Fish, t: number, dt: number) {
    if (t > f.until || Math.hypot(f.tx - f.x, f.ty - f.y) < 30) pickTarget(f, t);
    const fleeing = f.flee > t;
    // Fish swim mostly level: cap the climb or dive at about 25°.
    const level = 0.44;
    let desired = Math.atan2(f.ty - f.y, f.tx - f.x);
    const right = Math.cos(desired) >= 0;
    const pitch = right ? desired : wrap(Math.PI - desired);
    desired = Math.max(-level, Math.min(level, pitch));
    if (!right) desired = wrap(Math.PI - desired);
    const turnRate = fleeing ? 7 : 1.4; // radians per second
    // Turning around is a quick flip (seen side-on), never a swing through vertical.
    if (Math.cos(desired) * Math.cos(f.heading) < 0) {
      f.heading = wrap(Math.PI - f.heading);
      f.turn = 0;
    }
    f.turn = Math.min(1, f.turn + dt * (fleeing ? 10 : 4));
    const delta = wrap(desired - f.heading);
    f.heading += Math.sign(delta) * Math.min(Math.abs(delta), turnRate * dt) + Math.sin(t * 1.3 + f.wag) * 0.004;
    const goal = fleeing ? 200 : f.cruise;
    f.speed += (goal - f.speed) * Math.min(1, dt * (fleeing ? 6 : 1.2));
    f.x += Math.cos(f.heading) * f.speed * dt;
    f.y += Math.sin(f.heading) * f.speed * dt;
    f.x = Math.min(water.x1 + 60, Math.max(water.x0 - 60, f.x));
    f.y = Math.min(water.y1 + 30, Math.max(water.y0 - 30, f.y));

    f.wag += dt * (5 + f.speed * 0.1);
    const swing = Math.sin(f.wag) * Math.min(28, 8 + f.speed * 0.15);
    f.tail.setAttribute('transform', `rotate(${swing.toFixed(1)} -12 0)`);
    const deg = (f.heading * 180) / Math.PI;
    const squash = (0.25 + 0.75 * f.turn).toFixed(2); // narrows mid-turn
    const flip = Math.cos(f.heading) < 0 ? ` scale(${squash} -1)` : ` scale(${squash} 1)`; // eye stays on top
    f.g.setAttribute('transform', `translate(${f.x.toFixed(1)} ${f.y.toFixed(1)}) rotate(${deg.toFixed(1)})${flip}`);
  }

  hero.addEventListener('click', (e) => {
    const pt = sea.createSVGPoint();
    pt.x = e.clientX; pt.y = e.clientY;
    const p = pt.matrixTransform(sea.getScreenCTM()!.inverse());
    if (p.y < 320) return; // sky, not water
    const ring = svg('ellipse', { cx: p.x, cy: p.y, rx: 4, ry: 1.5 }, rippleLayer);
    const t0 = performance.now();
    const grow = (t: number) => {
      const k = (t - t0) / 1200;
      if (k >= 1) return ring.remove();
      ring.setAttribute('rx', String(4 + k * 70));
      ring.setAttribute('ry', String(1.5 + k * 22));
      ring.setAttribute('opacity', String(1 - k));
      requestAnimationFrame(grow);
    };
    requestAnimationFrame(grow);
    const t = performance.now() / 1000;
    for (const f of fish) {
      const dx = f.x - p.x, dy = f.y - p.y, d = Math.hypot(dx, dy) || 1;
      if (d > 380) continue;
      // Dart away from the ripple, then settle back into wandering.
      f.tx = f.x + (dx / d) * 260;
      f.ty = Math.min(water.y1, Math.max(water.y0, f.y + (dy / d) * 120));
      f.flee = t + 0.7;
      f.until = t + 1.6;
    }
  });

  let last = performance.now();
  function frame(now: number) {
    const s = reduce ? 0 : now / 1000;
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    // Scrolling through the hero rows the boat off to the right, towards the river.
    const progress = Math.min(1, scrollY / hero.offsetHeight);
    bubbleStack.classList.toggle('gone', scrollY > 24); // the chat clears once you start rowing
    vessel.style.transform = `translate(${progress * innerWidth * 0.7}px, ${Math.sin(s * 1.6) * 4}px) rotate(${Math.sin(s * 1.6 + 0.8) * 1.4}deg)`;
    for (const f of fish) swim(f, now / 1000, reduce ? 0 : dt);
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
</script>
