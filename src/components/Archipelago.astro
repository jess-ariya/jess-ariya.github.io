---
// Five project islets strung along a dotted route. Hovering one paints it in and floats up a preview.
// Phones get a plain list instead.
import { Image } from 'astro:assets';
import { blob } from '../lib/blob';
import { projects } from '../data/projects';

const W = 820, H = 300;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*', { eager: true });
const image = (name: string) => images[`../assets/work/${name}`].default;
const R = 56; // islet radius: wide enough that the longest name sits inside the blob
---
<div class="arch">
  <svg class="map" viewBox={`0 0 ${W} ${H}`} role="list" aria-label="Case studies">
    {projects.map((p, i) => (
      <a class="islet" href={p.href} role="listitem" data-i={i} style={`--c:${p.colour}`} aria-label={`${p.name}: ${p.blurb}`}>
        <path class="blob" d={blob(p.at[0], p.at[1], R, 0.3, 9, 50 + i * 13)} filter="url(#wobble)" />
        <text x={p.at[0]} y={p.at[1] + 6} text-anchor="middle">{p.name}</text>
        <text x={p.at[0]} y={p.at[1] + R * 0.8 + 26} text-anchor="middle" class="sub">{p.tags}</text>
      </a>
    ))}
  </svg>
  {projects.map((p, i) => (
    <figure class="tip" data-i={i} aria-hidden="true" style={`left:${(p.at[0] / W) * 100}%;top:${(p.at[1] / H) * 100}%;--tilt:${i % 2 ? 2 : -2}deg`}>
      <Image src={image(p.image)} alt="" width={360} format="webp" />
      <figcaption>{p.blurb}</figcaption>
    </figure>
  ))}
</div>

<ul class="list">
  {projects.map((p) => (
    <li><a href={p.href} style={`--c:${p.colour}`}><b>{p.name}</b><span>{p.blurb}</span></a></li>
  ))}
</ul>

<style>
  .arch { position: relative; width: 100%; max-width: 820px; }
  .map { width: 100%; height: auto; display: block; overflow: visible; }
  .islet { cursor: pointer; }
  .islet .blob {
    fill: var(--leaf); stroke: var(--ink); stroke-width: 1.4;
    transition: fill 0.4s, transform 0.5s var(--ease); transform-box: fill-box; transform-origin: center;
  }
  .islet:hover .blob, .islet:focus-visible .blob { fill: var(--c); transform: scale(1.06) rotate(-2deg); }
  .islet:focus-visible { outline: none; }
  .islet:focus-visible .blob { stroke: var(--walnut); stroke-width: 2.5; }
  .islet text { font: 20px var(--hand); fill: var(--ink); }
  .islet .sub { font: 13px var(--body); fill: var(--muted); }

  /* Preview card floating above the hovered islet */
  .tip {
    position: absolute; z-index: 5; margin: 0; width: 190px; padding: 8px 8px 10px;
    background: var(--bubble); border: 1.5px solid var(--ink); border-radius: 14px 10px 16px 12px;
    box-shadow: 0 14px 28px -18px rgb(43 42 38 / 0.6);
    pointer-events: none; opacity: 0;
    transform: translate(-50%, calc(-100% - 56px)) rotate(var(--tilt)) translateY(8px) scale(0.96);
    transition: opacity 0.25s, transform 0.4s var(--ease);
  }
  .tip img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px 6px 10px 7px; background: var(--paper-light); }
  .tip figcaption { font-size: 13px; line-height: 1.35; color: var(--muted); margin-top: 6px; }
  .arch:has(.islet[data-i='0']:is(:hover, :focus-visible)) .tip[data-i='0'],
  .arch:has(.islet[data-i='1']:is(:hover, :focus-visible)) .tip[data-i='1'],
  .arch:has(.islet[data-i='2']:is(:hover, :focus-visible)) .tip[data-i='2'],
  .arch:has(.islet[data-i='3']:is(:hover, :focus-visible)) .tip[data-i='3'],
  .arch:has(.islet[data-i='4']:is(:hover, :focus-visible)) .tip[data-i='4'] {
    opacity: 1; transform: translate(-50%, calc(-100% - 56px)) rotate(var(--tilt));
  }

  .list { display: none; gap: 14px; list-style: none; padding: 0; margin: 0; }
  .list a {
    display: grid; gap: 2px; padding: 16px 18px; text-decoration: none;
    background: var(--paper-light); border: 1.5px solid var(--ink); border-radius: 22px 18px 24px 16px;
    box-shadow: inset 6px 0 0 var(--c);
  }
  .list b { font: 400 22px var(--display); }
  .list span { font-size: 14px; color: var(--muted); }
  @media (max-width: 760px) {
    .arch { display: none; }
    .list { display: grid; }
  }
</style>
