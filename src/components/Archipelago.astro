---
// The Work island with a ring of project islets. Islets paint in on hover; phones get a plain list.
import { blob } from '../lib/blob';
import { projects } from '../data/projects';

const centre: [number, number] = [410, 235];
const toward = ([x, y]: [number, number]) => [centre[0] + (x - centre[0]) * 0.35, centre[1] + (y - centre[1]) * 0.35];
const island = blob(centre[0], centre[1], 120, 0.25, 11, 9);
---
<svg class="map" viewBox="0 0 820 470" role="list" aria-label="Case studies">
  <g aria-hidden="true">
    {projects.map((p) => {
      const [x2, y2] = toward(p.at);
      return <path d={`M${p.at[0]} ${p.at[1]} L${x2} ${y2}`} class="route" />;
    })}
    <path d={island} fill="#A9C178" opacity=".85" filter="url(#wc)" />
    <path d={island} fill="none" stroke="#2B2A26" stroke-width="1.4" filter="url(#wobble)" />
    <path d={blob(395, 225, 60, 0.3, 9, 21)} fill="#5F7D43" opacity=".6" filter="url(#wc)" />
    <text x={centre[0]} y={centre[1] + 10} text-anchor="middle" class="big">Work</text>
  </g>
  {projects.map((p, i) => (
    <a class="islet" href={p.href} role="listitem" style={`--c:${p.colour}`} aria-label={`${p.name}: ${p.blurb}`}>
      <path class="blob" d={blob(p.at[0], p.at[1], 38, 0.35, 8, 50 + i * 13)} filter="url(#wobble)" />
      <text x={p.at[0]} y={p.at[1] + 6} text-anchor="middle">{p.name}</text>
      <text x={p.at[0]} y={p.at[1] + 60} text-anchor="middle" class="sub">{p.tags}</text>
    </a>
  ))}
</svg>

<ul class="list">
  {projects.map((p) => (
    <li><a href={p.href} style={`--c:${p.colour}`}><b>{p.name}</b><span>{p.blurb}</span></a></li>
  ))}
</ul>

<style>
  .map { width: 100%; max-width: 820px; height: auto; display: block; overflow: visible; }
  .route { stroke: var(--sea-deep); stroke-width: 1.2; stroke-dasharray: 2 6; fill: none; }
  .big { font: 30px var(--display); fill: var(--ink); }
  .islet { cursor: pointer; }
  .islet .blob {
    fill: var(--stone); stroke: var(--ink); stroke-width: 1.4;
    transition: fill 0.4s, transform 0.5s var(--ease); transform-box: fill-box; transform-origin: center;
  }
  .islet:hover .blob, .islet:focus-visible .blob { fill: var(--c); transform: scale(1.06) rotate(-2deg); }
  .islet:focus-visible { outline: none; }
  .islet:focus-visible .blob { stroke: var(--walnut); stroke-width: 2.5; }
  .islet text { font: 20px var(--hand); fill: var(--ink); }
  .islet .sub { font: 13px var(--body); fill: var(--muted); }

  .list { display: none; gap: 14px; list-style: none; padding: 0; margin: 0; }
  .list a {
    display: grid; gap: 2px; padding: 16px 18px; text-decoration: none;
    background: var(--paper-light); border: 1.5px solid var(--ink); border-radius: 22px 18px 24px 16px;
    box-shadow: inset 6px 0 0 var(--c);
  }
  .list b { font: 400 22px var(--display); }
  .list span { font-size: 14px; color: var(--muted); }
  @media (max-width: 760px) {
    .map { display: none; }
    .list { display: grid; }
  }
</style>
